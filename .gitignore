keystore.jks
google-services.json
service-account.json

# Build artifacts
node_modules/
.wrangler/
dist/
build/
.gradle/
*.apk
*.aab

# Android Studio
.idea/
*.iml
local.properties

# macOS / Windows
.DS_Store
Thumbs.db

# Ingest raw/normalized data — too big (1.6GB HF), regenerable from source scripts
backend/ingest/raw/
backend/ingest/normalized/
backend/ingest/image-migrate.sql
backend/ingest/*.sql
backend/ingest/*.json
backend/ingest/*.ndjson
# Subdirectory data (audit corpora, scrape outputs, cocktail NDJSONs ≥100MB total) —
# regenerable via the *.cjs scripts in this folder. Keep scripts, drop data.
backend/ingest/**/*.ndjson
backend/ingest/**/*.json
backend/ingest/audit_v2_data/
backend/ingest/audit_v2_hf/
backend/ingest/audit_v2_mocktails_data/
backend/ingest/audit_v3_cfg/
backend/ingest/audit_v3_hf/
backend/ingest/audit_v3_tmdb/
backend/ingest/audit_v3_usda/
backend/ingest/scrape_5star/
backend/ingest/scrape_drinks/
backend/ingest/cocktails/agent5/
backend/ingest/cocktails/_quarantine/
backend/ingest/photo_backfill_log.csv
backend/ingest/photo_backfill_pending.csv
# Link-parser is a separate Oracle-box deploy artifact — large node_modules + scrape cache.
backend/ingest/link-parser/

# Source PDFs from Internet Archive cocktail-book scrapes — over GitHub's 100MB limit.
# Extracted text already committed via NDJSON; the PDFs themselves regenerate from fetchers.
backend/ingest/cocktails/raw/*.pdf
backend/ingest/cocktails/_tmp/

# Android build outputs (can be hundreds of MB)
android/app/build/
android/.gradle/
android/.kotlin/
android/build/
android/captures/
android/.cxx/

# Backend build / local state
backend/.wrangler/
backend/node_modules/

# Pentest artifacts — keep scripts, ignore generated output
pentest/reports/
pentest/output/

# Admin key + anything else ending _KEY.txt
*_KEY.txt
PANTRIE_ADMIN_KEY.txt

# Debug/release APKs — don't commit binaries
*.apk
*.aab

# Logs / editor / temp
*.log
/tmp/
*.swp
.vscode/

# Keystore files (any location)
*.keystore
*.jks
pan-tree/

# Large generated CSVs in ingest — regenerable.
backend/ingest/photo_backfill_log.csv
backend/ingest/photo_backfill_pending.csv

# Cocktail-archive scrape cache (69MB+ of cached HTML / text from Archive.org,
# EUVS, Gutenberg, Wikisource). Fully regenerable from the fetch-historical-*.js
# scripts. Logs are append-only and noisy — keep the scripts, drop the cache+logs.
backend/ingest/cocktails/_cache/
backend/ingest/cocktails/_logs_*.txt

<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- API 31+ splash override. Background flipped to near-black to match the
         editorial dark theme; the brand icon stays for one second before Compose
         takes over with PantrieTheme's surface color. -->
    <style name="Theme.Pantrie.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@android:color/black</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="windowSplashScreenAnimationDuration">1000</item>
        <item name="postSplashScreenTheme">@style/Theme.Pantrie</item>
    </style>
</resources>

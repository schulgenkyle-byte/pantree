<resources>
    <!-- Speakeater editorial dark base. The Compose `PantrieTheme` owns the actual
         color scheme; this style only sets the system-chrome defaults so the splash,
         status bar, and pre-Compose first-frame don't flash white before MaterialTheme
         takes over. windowLightStatusBar=false because our background is near-black,
         so we want light icons in the status bar. -->
    <style name="Theme.Pantrie" parent="android:Theme.Material.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowBackground">@android:color/black</item>
    </style>

    <style name="Theme.Pantrie.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@android:color/black</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.Pantrie</item>
    </style>
</resources>
